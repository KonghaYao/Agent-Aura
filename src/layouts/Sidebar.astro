---
import UserAvatar from "../../components/UserAvatar";
import { LayoutGrid, ShoppingBag, MessageSquare, FolderOpen, Image } from "lucide-react";

const navigation = [
    {
        name: "Aura",
        path: "/",
        icon: LayoutGrid,
        description: "AI Agent Platform",
        colorClass: "text-purple-600 dark:text-purple-400",
        bgClass: "bg-purple-100 dark:bg-purple-900/30"
    },
    {
        name: "Agent Store",
        path: "/agent-store",
        icon: ShoppingBag,
        description: "浏览和创建代理",
        colorClass: "text-blue-600 dark:text-blue-400",
        bgClass: "bg-blue-100 dark:bg-blue-900/30"
    },
    {
        name: "Agent Chat",
        path: "/agent",
        icon: MessageSquare,
        description: "与AI代理对话",
        colorClass: "text-emerald-600 dark:text-emerald-400",
        bgClass: "bg-emerald-100 dark:bg-emerald-900/30"
    },
    {
        name: "Image Gen",
        path: "/image-gen",
        icon: Image,
        description: "AI 图片生成",
        colorClass: "text-pink-600 dark:text-pink-400",
        bgClass: "bg-pink-100 dark:bg-pink-900/30"
    },
    {
        name: "Files",
        path: "/files",
        icon: FolderOpen,
        description: "文件管理",
        colorClass: "text-amber-600 dark:text-amber-400",
        bgClass: "bg-amber-100 dark:bg-amber-900/30"
    }
];

const currentPath = Astro.url.pathname;
---

<!-- Sidebar -->
<aside class="bg-background border-r border-border w-64 h-screen flex flex-col">
    <!-- Logo Section -->
    <div class="flex items-center h-16 px-6 border-b border-border/40">
        <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 border border-border rounded-md flex items-center justify-center shrink-0 bg-secondary/30">
                <span class="text-foreground font-bold text-lg">A</span>
            </div>
            <div class="block">
                <h1 class="text-foreground font-semibold text-lg tracking-tight">
                    Agent Aura
                </h1>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-3 py-6">
        <ul class="space-y-1">
            {navigation.map((item) => (
                <li>
                    <a
                        href={item.path}
                        class:list={[
                            "flex items-center gap-3 px-3 py-2 transition-colors duration-200 group/nav-item rounded-md",
                            currentPath === item.path
                                ? "bg-secondary text-foreground font-medium"
                                : "text-muted-foreground hover:bg-secondary/50 hover:text-foreground"
                        ]}
                        title={item.description}
                    >
                        <!-- Icon -->
                        <div class:list={[
                            "flex items-center justify-center w-8 h-8 rounded-lg shrink-0 transition-all duration-200",
                            item.bgClass,
                            item.colorClass,
                            currentPath === item.path ? '' + item.colorClass.replace('text-', 'ring-') : "opacity-80 group-hover/nav-item:opacity-100"
                        ]}>
                            <item.icon className="w-4 h-4 fill-current" />
                        </div>

                        <!-- Label -->
                        <span class="block text-sm">
                            {item.name}
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </nav>

    <!-- Footer -->
    <div class="p-4 border-t border-border/40">
       <UserAvatar client:only="react" ></UserAvatar>
    </div>
</aside>

<!-- Mobile Overlay (for future mobile support) -->
<div class="fixed inset-0 bg-black/50 -translate-x-full lg:hidden" id="mobile-overlay"></div>
